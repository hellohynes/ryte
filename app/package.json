{
  "name": "ryte",
  "version": "0.1.0",
  "description": "Local-first search and file workspace for a markdown folder",
  "main": "./out/main/index.js",
  "author": "Joshua Hynes",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "format": "prettier --write .",
    "guard:branch": "node scripts/guard-branch.mjs",
    "validate": "pnpm check:node && pnpm stencil:tokens --check && pnpm stencil:icons --check && pnpm stencil:manifest --check && pnpm check:stencil && pnpm check:site && pnpm lint && pnpm typecheck && pnpm test && pnpm test:release-scripts && pnpm build",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "rebuild:electron": "node_modules/.pnpm/node_modules/.bin/electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release-scripts": "node --test scripts/check-release-version.test.mjs",
    "smoke:indexer": "node scripts/run-indexer-smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-mac.mjs",
    "smoke:indexer:notes": "node --import tsx scripts/smoke-indexer.ts",
    "stencil": "vite --config vite.stencil.config.ts",
    "stencil:build": "vite build --config vite.stencil.config.ts",
    "test:stencil": "node scripts/test-stencil.mjs",
    "check:stencil": "node scripts/check-stencil.mjs",
    "check:site": "node ../scripts/check-site.mjs",
    "stencil:tokens": "node --import tsx scripts/generate-stencil-tokens.ts",
    "stencil:icons": "node --import tsx scripts/generate-stencil-icons.ts",
    "stencil:manifest": "node --import tsx scripts/generate-stencil-manifest.ts",
    "qa:local": "pnpm validate && pnpm smoke:indexer && pnpm launch",
    "launch": "node scripts/dev-electron.mjs node scripts/start-preview.mjs",
    "start": "pnpm build && pnpm launch",
    "dev": "node scripts/dev-electron.mjs electron-vite dev",
    "build": "node scripts/check-node-version.mjs && pnpm typecheck && electron-vite build",
    "postinstall": "node_modules/.pnpm/node_modules/.bin/electron-rebuild -f -w better-sqlite3 || electron-builder install-app-deps",
    "prepare": "node ../scripts/install-git-hooks.mjs",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:mac": "pnpm build && electron-builder --mac",
    "package:mac:arm64": "pnpm build && electron-builder --mac dmg --arm64 --publish never --config.mac.identity=- --config.mac.notarize=false --config.mac.hardenedRuntime=false && codesign --verify --deep --strict --verbose=2 dist/mac-arm64/Ryte.app && pnpm smoke:packaged && node scripts/remove-unpacked-mac-build.mjs",
    "package:mac:arm64:signed": "pnpm build && electron-builder --mac dmg --arm64 --publish never && pnpm smoke:packaged",
    "release:check": "node scripts/check-release-version.mjs",
    "release:mac:arm64": "node scripts/check-release-environment.mjs && pnpm package:mac:arm64:signed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "openai": "^4.77.0",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/cascadia-mono": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/reddit-mono": "^5.3.0",
    "@fontsource-variable/reddit-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/ubuntu-sans": "^5.3.0",
    "@fontsource-variable/ubuntu-sans-mono": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@shikijs/markdown-it": "^4.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^41.6.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.16.0",
    "paper": "^0.16.0",
    "paperjs-offset": "^2.2.2",
    "pinia": "^2.3.0",
    "prettier": "^3.7.4",
    "shiki": "^4.0.2",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^2.1.8",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.12.1",
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9"
  }
}
